# ==============================================================================
# Vivado & FPGA Project .gitignore
# ==============================================================================

# --- Vivado Project Files & Generated Folders ---
*.xpr
.Xil/
*.cache/
*.hw/
*.sim/
*.ip_user_files/
*.runs/
*.gen/

# --- Temporary Files, Logs, and Journals ---
*.log
*.jou
*.str
vivado*.zip
vivado_*.str
hd_visual/
webtalk*.log
webtalk*.jou

# --- Simulation Artifacts ---
xsim.dir/
*.pb
*.wdb
*.vcd
*.mif
*.pak
*.tmp

# --- Generated Bitstreams & Target Hardware Exports ---
# Note: Remove *.bit or *.xsa if you explicitly want to track release bitstreams in Git
*.bit
*.bin
*.sysdef
*.hdf
*.xsa

# --- Vitis / SDK Projects ---
.sdk/
workspace/

# --- OS & Editor Metadata ---
.DS_Store
Thumbs.db
.vscode/
.idea/
